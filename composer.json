{
    "name": "dawid/nextcloud-talk-stickers",
    "description": "Development tools of the Nextcloud app talk_stickers (app/talk_stickers); not part of the app",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.5",
        "nextcloud/ocp": "dev-stable32",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^7"
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\TalkStickers\\": "app/talk_stickers/lib/",
            "OCA\\TalkStickers\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --threads=1 --no-cache"
    }
}
