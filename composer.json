{
    "name": "dawid/nextcloud-talk-stickers",
    "description": "Development tools of the Nextcloud app talk_stickers (app/talk_stickers); not part of the app",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-stable32",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\TalkStickers\\": "app/talk_stickers/lib/",
            "OCA\\TalkStickers\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
